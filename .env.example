# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8001
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
REDIS_URL=redis://localhost:6379/0

# Which interface this process serves: "public" (customer site + provider dashboard + API)
# or "admin" (platform admin console). Each runs as its own service on its own host.
SITE_ROLE=public

# One-time codes. "console" prints codes to the log (development only).
# "twilio" uses Twilio Verify (WhatsApp, SMS, email via SendGrid).
OTP_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Reminders / notifications. "console" logs messages instead of sending.
MESSAGING_BACKEND=console
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Payments are switched off until the bank and DigiWallet agreements are in place.
# While off, every deposit is BZ$0 and bookings go straight to "confirmed".
PAYMENTS_ENABLED=0

# Public base URL used in reminder links
PUBLIC_BASE_URL=http://localhost:8000
